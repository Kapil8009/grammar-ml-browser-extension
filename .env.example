# Inference model. The default is CPU-friendly (~77M parameters).
GEC_MODEL_NAME=jbochi/coedit-small
GEC_MODEL_PREFIX="Fix the grammar: "
GEC_DEVICE=auto
GEC_MAX_INPUT_TOKENS=384
GEC_MAX_NEW_TOKENS=256
GEC_NUM_BEAMS=4
GEC_MODEL_REVISION=main
# Prefer safe tensor weights. Set false only for a reviewed, revision-pinned model.
GEC_USE_SAFETENSORS=true

# API and browser-extension access.
GEC_ALLOWED_ORIGINS=*
GEC_API_KEY=
GEC_MAX_TEXT_CHARS=12000
GEC_PRELOAD_MODEL=false
GEC_LOG_LEVEL=INFO
